{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/guide",
        "destination": "/guide.html"
      },
      {
        "source": "/manual",
        "destination": "/guide.html"
      },
      {
        "source": "/docs",
        "destination": "/guide.html"
      },
      {
        "source": "/complete-guide",
        "destination": "/PEERLENS_COMPLETE_GUIDE.html"
      },
      {
        "source": "/complete_guide",
        "destination": "/PEERLENS_COMPLETE_GUIDE.html"
      },
      {
        "source": "/full-guide",
        "destination": "/PEERLENS_COMPLETE_GUIDE.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
