# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Source code and config files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.rules text eol=lf
*.svg text eol=lf

# Binary assets (do not convert line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.xlsx binary
