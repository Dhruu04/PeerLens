rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication & authorization helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminOwner(adminId) {
      return isAuthenticated() && request.auth.uid == adminId;
    }

    // Root instructor workspaces & profile data
    match /admins/{adminId} {
      // Authenticated course convenors have full read/write authority over their workspace
      allow read, write: if isAdminOwner(adminId);

      // Classrooms collection scoped to instructor
      match /classes/{classId} {
        // Instructor has complete authority
        allow create, delete: if isAdminOwner(adminId);
        allow read, write: if isAdminOwner(adminId);

        // Student portal access rules:
        // 1. Students can read classroom configurations (criteria rubrics, 30s pulse rounds, deadlines)
        //    Internal workspace settings (_settings_workspace) are strictly protected
        allow get: if classId != '_settings_workspace';
        allow list: if true;

        // 2. Students can submit peer reviews, complete 30-second team health pulses, and self-enroll
        allow update: if classId != '_settings_workspace';
      }

      // Recursive fallback for nested instructor collections
      match /{allPaths=**} {
        allow read, write: if isAdminOwner(adminId);
      }
    }
  }
}
